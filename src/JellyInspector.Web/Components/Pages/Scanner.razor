    private async Task ExportCsvAsync()
    {
        try
        {
            var exportRows = BuildExportRows();

            if (exportRows.Length == 0)
            {
                _errorMessage =
                    "No hay resultados para exportar.";
                return;
            }

            var csv = new StringBuilder();

            csv.AppendLine(
                "Serie;Año;JellyfinId;Temporadas;" +
                "Episodios disponibles;Episodios esperados;" +
                "Completada;Tipo de incidencia;Temporada;" +
                "Episodio;Descripción;Estado");

            foreach (var exportRow in exportRows)
            {
                var row = exportRow.Row;
                var issue = exportRow.Issue;

                csv.Append(CsvEscape(row.Name));
                csv.Append(';');
                csv.Append(CsvEscape(
                    row.Series?.ProductionYear > 0
                        ? row.Series.ProductionYear.ToString()
                        : string.Empty));
                csv.Append(';');
                csv.Append(CsvEscape(row.JellyfinId));
                csv.Append(';');
                csv.Append(CsvEscape(
                    row.Series?.SeasonCount.ToString()
                    ?? string.Empty));
                csv.Append(';');
                csv.Append(GetAvailableEpisodeCount(row));
                csv.Append(';');
                csv.Append(GetExpectedEpisodeCount(row));
                csv.Append(';');
                csv.Append(CsvEscape(
                    GetCompletionPercentage(row)
                        .ToString(
                            "0.##",
                            System.Globalization.CultureInfo.InvariantCulture)));
                csv.Append(';');
                csv.Append(CsvEscape(
                    issue is null
                        ? string.Empty
                        : GetIssueLabel(issue.Type)));
                csv.Append(';');
                csv.Append(CsvEscape(
                    issue?.SeasonNumber?.ToString()
                    ?? string.Empty));
                csv.Append(';');
                csv.Append(CsvEscape(
                    issue?.EpisodeNumber?.ToString()
                    ?? string.Empty));
                csv.Append(';');
                csv.Append(CsvEscape(
                    issue is null
                        ? "Sin incidencias"
                        : GetIssueDescription(issue)));
                csv.Append(';');
                csv.Append(CsvEscape(GetRowStatus(row)));
                csv.AppendLine();
            }

            var utf8Preamble = Encoding.UTF8.GetPreamble();
            var csvBytes = Encoding.UTF8.GetBytes(csv.ToString());
            var bytes = new byte[utf8Preamble.Length + csvBytes.Length];

            Buffer.BlockCopy(
                utf8Preamble,
                0,
                bytes,
                0,
                utf8Preamble.Length);

            Buffer.BlockCopy(
                csvBytes,
                0,
                bytes,
                utf8Preamble.Length,
                csvBytes.Length);

            await DownloadFileAsync(
                $"jellyinspector-{DateTime.Now:yyyyMMdd-HHmmss}.csv",
                "text/csv;charset=utf-8",
                bytes);
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"No se pudo exportar el CSV: {ex.Message}";
        }
    }

    private async Task ExportExcelAsync()
    {
        try
        {
            var exportRows = BuildExportRows();

            if (exportRows.Length == 0)
            {
                _errorMessage =
                    "No hay resultados para exportar.";
                return;
            }

            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Incidencias");

            var headers = new[]
            {
                "Serie",
                "Año",
                "Jellyfin ID",
                "Temporadas",
                "Episodios disponibles",
                "Episodios esperados",
                "Completada (%)",
                "Tipo de incidencia",
                "Temporada",
                "Episodio",
                "Descripción",
                "Estado"
            };

            for (var column = 0;
                 column < headers.Length;
                 column++)
            {
                worksheet.Cell(1, column + 1).Value =
                    headers[column];
            }

            var excelRow = 2;

            foreach (var exportRow in exportRows)
            {
                var row = exportRow.Row;
                var issue = exportRow.Issue;

                worksheet.Cell(excelRow, 1).Value =
                    row.Name;

                if (row.Series?.ProductionYear > 0)
                {
                    worksheet.Cell(excelRow, 2).Value =
                        row.Series.ProductionYear;
                }

                worksheet.Cell(excelRow, 3).Value =
                    row.JellyfinId;

                if (row.Series is not null)
                {
                    worksheet.Cell(excelRow, 4).Value =
                        row.Series.SeasonCount;
                }

                worksheet.Cell(excelRow, 5).Value =
                    GetAvailableEpisodeCount(row);

                worksheet.Cell(excelRow, 6).Value =
                    GetExpectedEpisodeCount(row);

                worksheet.Cell(excelRow, 7).Value =
                    GetCompletionPercentage(row);

                worksheet.Cell(excelRow, 8).Value =
                    issue is null
                        ? string.Empty
                        : GetIssueLabel(issue.Type);

                if (issue?.SeasonNumber is int seasonNumber)
                {
                    worksheet.Cell(excelRow, 9).Value =
                        seasonNumber;
                }

                if (issue?.EpisodeNumber is int episodeNumber)
                {
                    worksheet.Cell(excelRow, 10).Value =
                        episodeNumber;
                }

                worksheet.Cell(excelRow, 11).Value =
                    issue is null
                        ? "Sin incidencias"
                        : GetIssueDescription(issue);

                worksheet.Cell(excelRow, 12).Value =
                    GetRowStatus(row);

                excelRow++;
            }

            var headerRange =
                worksheet.Range(
                    1,
                    1,
                    1,
                    headers.Length);

            headerRange.Style.Font.Bold = true;
            headerRange.Style.Fill.BackgroundColor =
                XLColor.LightGray;

            worksheet.Column(7)
                .Style.NumberFormat.Format =
                "0.00";

            worksheet.SheetView.FreezeRows(1);
            worksheet.RangeUsed()?.SetAutoFilter();
            worksheet.Columns().AdjustToContents();

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);

            await DownloadFileAsync(
                $"jellyinspector-{DateTime.Now:yyyyMMdd-HHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                stream.ToArray());
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"No se pudo exportar el Excel: {ex.Message}";
        }
    }

    private ExportRow[] BuildExportRows()
    {
        var exportRows = new List<ExportRow>();

        foreach (var row in FilteredRows)
        {
            var visibleIssues = GetVisibleIssues(row);

            if (visibleIssues.Count == 0)
            {
                exportRows.Add(new ExportRow
                {
                    Row = row
                });

                continue;
            }

            foreach (var issue in visibleIssues)
            {
                exportRows.Add(new ExportRow
                {
                    Row = row,
                    Issue = issue
                });
            }
        }

        return exportRows.ToArray();
    }

    private async Task DownloadFileAsync(
        string fileName,
        string contentType,
        byte[] bytes)
    {
        var base64 =
            Convert.ToBase64String(bytes);

        var script =
            "(() => {" +
            "const link = document.createElement('a');" +
            $"link.href = 'data:{contentType};base64,{base64}';" +
            $"link.download = '{fileName}';" +
            "document.body.appendChild(link);" +
            "link.click();" +
            "link.remove();" +
            "})();";

        await JSRuntime.InvokeVoidAsync(
            "eval",
            script);
    }

    private static string CsvEscape(
        string? value)
    {
        var normalized =
            (value ?? string.Empty)
                .Replace(
                    "\"",
                    "\"\"");

        return $"\"{normalized}\"";
    }

    private void OpenSeries(
        string jellyfinId)
    {
        if (string.IsNullOrWhiteSpace(jellyfinId))
        {
            return;
        }

        Navigation.NavigateTo(
            $"/series/" +
            $"{Uri.EscapeDataString(jellyfinId)}");
    }

    private async Task OpenInJellyfinAsync(
        string jellyfinId)
    {
        if (string.IsNullOrWhiteSpace(jellyfinId))
        {
            return;
        }

        var jellyfinUrl =
            await JellyfinService.GetItemWebUrlAsync(
                jellyfinId);

        if (string.IsNullOrWhiteSpace(jellyfinUrl))
        {
            _errorMessage =
                "No se ha configurado la URL del servidor Jellyfin.";

            await InvokeAsync(StateHasChanged);
            return;
        }

        await JSRuntime.InvokeVoidAsync(
            "open",
            jellyfinUrl,
            "_blank");
    }

