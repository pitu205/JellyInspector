@page "/scanner"
@rendermode InteractiveServer

@using JellyInspector.Application.Library
@using JellyInspector.Application.Scanning
@using JellyInspector.Web.Components.Scanner
@using JellyInspector.Application.Interfaces
@using Microsoft.JSInterop
@using ClosedXML.Excel
@using System.Text

@inject IScannerService ScannerService
@inject ILastScanService LastScanService
@inject ILibraryService LibraryService
@inject IJellyfinService JellyfinService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Escaneo</PageTitle>

<MudStack Row="true"
          AlignItems="AlignItems.Center"
          Justify="Justify.SpaceBetween"
          Class="mb-4">

    <div>
        <MudText Typo="Typo.h4">
            Escaneo
        </MudText>

        <MudText Typo="Typo.body2"
                 Color="Color.Secondary">
            Análisis de incidencias de la biblioteca
        </MudText>
    </div>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ManageSearch"
               Disabled="@IsScanRunning"
               OnClick="StartScan">

        @if (IsScanRunning)
        {
            <MudProgressCircular Size="Size.Small"
                                 Indeterminate="true"
                                 Class="mr-2" />
        }

        Escanear biblioteca

    </MudButton>

</MudStack>

@if (_loadingLastScan)
{
    <MudPaper Class="pa-6 mb-4"
              Elevation="1">

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="2">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Small" />

            <MudText>
                Cargando el último escaneo...
            </MudText>

        </MudStack>

    </MudPaper>
}

@if (IsScanRunning)
{
    <MudPaper Class="pa-4 mb-4 scan-running-panel"
              Elevation="1">

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Class="mb-3">

            <MudText Typo="Typo.h6">
                Analizando biblioteca
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.StopCircle"
                       Disabled="@(!ScannerService.CanCancel || _cancellingScan)"
                       OnClick="StopScanAsync">
                @(_cancellingScan ? "Deteniendo..." : "Detener escaneo")
            </MudButton>

        </MudStack>

        <MudProgressLinear Color="Color.Primary"
                           Value="@ScannerService.Progress.Percentage"
                           Rounded="true"
                           Class="mb-3" />

        <div class="scan-working-visual">

            <MudIcon Icon="@Icons.Material.Filled.ManageSearch"
                     Color="Color.Primary"
                     Size="Size.Large"
                     Class="scan-rotating-search" />

            <MudText Typo="Typo.body2"
                     Color="Color.Primary"
                     Class="scan-working-phase">
                Analizando biblioteca...
            </MudText>

            <MudText Typo="Typo.h6"
                     Class="scan-working-series">
                @(string.IsNullOrWhiteSpace(ScannerService.Progress.CurrentSeries)
                    ? "Preparando escaneo..."
                    : ScannerService.Progress.CurrentSeries)
            </MudText>

        </div>

        <div class="scan-progress-summary">

            <div class="scan-progress-stat">
                <MudIcon Icon="@Icons.Material.Filled.Movie"
                         Color="Color.Primary"
                         Size="Size.Medium" />

                <div>
                    <strong>
                        @ScannerService.Progress.Current /
                        @ScannerService.Progress.Total
                    </strong>
                    <span>Series procesadas</span>
                </div>
            </div>

            <div class="scan-progress-percent">
                <MudProgressCircular Value="@ScannerService.Progress.Percentage"
                                     Color="Color.Primary"
                                     Size="Size.Large"
                                     StrokeWidth="5" />

                <strong>
                    @ScannerService.Progress.Percentage.ToString("0.#") %
                </strong>

                <span>Progreso</span>
            </div>

            <div class="scan-progress-stat scan-progress-status">
                <MudIcon Icon="@Icons.Material.Filled.Sync"
                         Color="Color.Secondary"
                         Size="Size.Medium" />

                <div>
                    <strong>En curso</strong>
                    <span>Escaneo activo</span>
                </div>
            </div>

        </div>

    </MudPaper>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error"
              Variant="Variant.Filled"
              Class="mb-4">

        @_errorMessage

    </MudAlert>
}

@if (!_loadingLastScan &&
     _result is null &&
     !IsScanRunning)
{
    <MudPaper Class="pa-8"
              Elevation="1">

        <MudStack AlignItems="AlignItems.Center"
                  Spacing="3">

            <MudIcon Icon="@Icons.Material.Filled.ManageSearch"
                     Color="Color.Primary"
                     Size="Size.Large" />

            <MudText Typo="Typo.h6">
                Todavía no se ha realizado ningún escaneo
            </MudText>

            <MudText Typo="Typo.body2"
                     Color="Color.Secondary">

                Pulsa «Escanear biblioteca» para analizar las series.

            </MudText>

        </MudStack>

    </MudPaper>
}

@if (_result is not null &&
     !IsScanRunning &&
     !_loadingLastScan)
{
    <MudPaper Class="pa-3 mb-4 scan-health-panel"
              Elevation="2">

        <div class="scan-health-inline">

            <div class="scan-health-title">
                <MudText Typo="Typo.h6">
                    Salud global de la biblioteca
                </MudText>

                <MudChip T="string"
                         Size="Size.Small"
                         Color="@GetLibraryHealthColor()"
                         Variant="Variant.Filled"
                         Icon="@GetLibraryHealthIcon()">
                    @GetLibraryHealthLabel()
                </MudChip>
            </div>

            <button type="button"
                    class='@GetHealthFilterClass(ScanFilter.Perfect, "scan-health-status-perfect")'
                    @onclick="@(() => ApplyHealthFilter(ScanFilter.Perfect))">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Color="Color.Success"
                         Size="Size.Medium" />
                <strong>@PerfectSeriesCount</strong>
                <span>Perfectas</span>
            </button>

            <button type="button"
                    class='@GetHealthFilterClass(ScanFilter.Airing, "scan-health-status-airing")'
                    @onclick="@(() => ApplyHealthFilter(ScanFilter.Airing))">
                <MudIcon Icon="@Icons.Material.Filled.LiveTv"
                         Color="Color.Info"
                         Size="Size.Medium" />
                <strong>@AiringSeriesCount</strong>
                <span>En emisión</span>
            </button>

            <button type="button"
                    class='@GetHealthFilterClass(ScanFilter.Upcoming, "scan-health-status-upcoming")'
                    @onclick="@(() => ApplyHealthFilter(ScanFilter.Upcoming))">
                <MudIcon Icon="@Icons.Material.Filled.Schedule"
                         Color="Color.Secondary"
                         Size="Size.Medium" />
                <strong>@UpcomingSeriesCount</strong>
                <span>Próximamente</span>
            </button>

            <button type="button"
                    class='@GetHealthFilterClass(ScanFilter.HealthWarnings, "scan-health-status-warning")'
                    @onclick="@(() => ApplyHealthFilter(ScanFilter.HealthWarnings))">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                         Color="Color.Warning"
                         Size="Size.Medium" />
                <strong>@WarningSeriesCount</strong>
                <span>Con avisos</span>
            </button>

            <button type="button"
                    class='@GetHealthFilterClass(ScanFilter.Critical, "scan-health-status-critical")'
                    @onclick="@(() => ApplyHealthFilter(ScanFilter.Critical))">
                <MudIcon Icon="@Icons.Material.Filled.Error"
                         Color="Color.Error"
                         Size="Size.Medium" />
                <strong>@CriticalSeriesCount</strong>
                <span>Críticas</span>
            </button>

            <div class="scan-health-progress">
                <div class="scan-health-progress-header">
                    <span>@_scanRows.Count series</span>
                    <strong style="color: var(--mud-palette-@GetLibraryHealthCssColor());">
                        @FormatLibraryHealth()
                    </strong>
                </div>

                <MudProgressLinear Value="@LibraryHealthPercentage"
                                   Color="@GetLibraryHealthColor()"
                                   Rounded="true" />
            </div>

        </div>

        <MudText Typo="Typo.caption"
                 Color="Color.Secondary"
                 Class="mt-2 scan-health-summary">
            @GetLibrarySummary()
        </MudText>

    </MudPaper>

    <MudGrid Spacing="2" Class="mb-4">

        <MudItem xs="6" sm="4" md="3" lg="2">
            <button type="button"
                    class="@GetStatFilterClass(ScanFilter.All)"
                    @onclick="@(() => ApplyHealthFilter(ScanFilter.All))">
                <MudIcon Icon="@Icons.Material.Filled.LiveTv"
                         Color="Color.Primary"
                         Size="Size.Medium" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Series</MudText>
                <MudText Typo="Typo.h5">@_result.Series</MudText>
            </button>
        </MudItem>

        <MudItem xs="6" sm="4" md="3" lg="2">
            <button type="button"
                    class="@GetStatFilterClass(ScanFilter.All)"
                    @onclick="@(() => ApplyHealthFilter(ScanFilter.All))">
                <MudIcon Icon="@Icons.Material.Filled.VideoLibrary"
                         Color="Color.Primary"
                         Size="Size.Medium" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Episodios</MudText>
                <MudText Typo="Typo.h5">@_result.Episodes</MudText>
            </button>
        </MudItem>

        <MudItem xs="6" sm="4" md="3" lg="2">
            <button type="button"
                    class="@GetStatFilterClass(ScanFilter.WithIssues)"
                    @onclick="@(() => ApplyHealthFilter(ScanFilter.WithIssues))">
                <MudIcon Icon="@Icons.Material.Filled.Error"
                         Color="@(AffectedSeriesCount > 0 ? Color.Error : Color.Success)"
                         Size="Size.Medium" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Con incidencias</MudText>
                <MudText Typo="Typo.h5"
                         Color="@(AffectedSeriesCount > 0 ? Color.Error : Color.Success)">
                    @AffectedSeriesCount
                </MudText>
            </button>
        </MudItem>

        <MudItem xs="6" sm="4" md="3" lg="2">
            <button type="button"
                    class="@GetStatFilterClass(ScanFilter.MissingEpisodes)"
                    @onclick="@(() => ApplyHealthFilter(ScanFilter.MissingEpisodes))">
                <MudIcon Icon="@Icons.Material.Filled.MovieFilter"
                         Color="@(MissingEpisodeIssueCount > 0 ? Color.Error : Color.Success)"
                         Size="Size.Medium" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Episodios faltantes</MudText>
                <MudText Typo="Typo.h5"
                         Color="@(MissingEpisodeIssueCount > 0 ? Color.Error : Color.Success)">
                    @MissingEpisodeIssueCount
                </MudText>
            </button>
        </MudItem>

        <MudItem xs="6" sm="4" md="3" lg="2">
            <button type="button"
                    class="@GetStatFilterClass(ScanFilter.MissingSeasons)"
                    @onclick="@(() => ApplyHealthFilter(ScanFilter.MissingSeasons))">
                <MudIcon Icon="@Icons.Material.Filled.FolderOff"
                         Color="@(MissingSeasonIssueCount > 0 ? Color.Warning : Color.Success)"
                         Size="Size.Medium" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Temporadas faltantes</MudText>
                <MudText Typo="Typo.h5"
                         Color="@(MissingSeasonIssueCount > 0 ? Color.Warning : Color.Success)">
                    @MissingSeasonIssueCount
                </MudText>
            </button>
        </MudItem>

        <MudItem xs="6" sm="4" md="3" lg="2">
            <MudPaper Class="pa-4 scan-stat-card" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.Timer"
                         Color="Color.Secondary"
                         Size="Size.Medium" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Duración</MudText>
                <MudText Typo="Typo.h6">@FormatDuration(_result.Duration)</MudText>
            </MudPaper>
        </MudItem>

    </MudGrid>

    @if (_scanRows.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4"
                  Elevation="1">

            <MudGrid Spacing="2">

                <MudItem xs="12" md="5">

                    <MudTextField T="string"
              @bind-Value="_search"
              Placeholder="Buscar serie o incidencia..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Immediate="true"
              Clearable="true"
              Variant="Variant.Outlined"
              Margin="Margin.Dense" />

                </MudItem>

                <MudItem xs="12" sm="6" md="4">

                    <div class="scan-native-select-wrapper">
                        <label for="scan-filter-select">Estado o incidencia</label>
                        <select id="scan-filter-select"
                                class="scan-native-select"
                                @bind="_filter">
                            <option value="@ScanFilter.All">Todas</option>
                            <option value="@ScanFilter.WithIssues">Solo con incidencias</option>
                            <option value="@ScanFilter.Complete">Solo completas</option>
                            <option value="@ScanFilter.Perfect">Perfectas</option>
                            <option value="@ScanFilter.HealthWarnings">Con avisos</option>
                            <option value="@ScanFilter.Critical">Críticas</option>
                            <option value="@ScanFilter.MissingEpisodes">Episodios faltantes</option>
                            <option value="@ScanFilter.MissingSeasons">Temporadas faltantes</option>
                            <option value="@ScanFilter.Airing">En emisión</option>
                            <option value="@ScanFilter.Upcoming">Próximamente</option>
                            <option value="@ScanFilter.Metadata">Metadatos</option>
                            <option value="@ScanFilter.Duplicates">Duplicados</option>
                        </select>
                    </div>

                </MudItem>

                <MudItem xs="12" sm="6" md="3">

                    <div class="scan-native-select-wrapper">
                        <label for="scan-sort-select">Ordenar por</label>
                        <select id="scan-sort-select"
                                class="scan-native-select"
                                @bind="_sort">
                            <option value="@ScanSort.NameAsc">Nombre (A-Z)</option>
                            <option value="@ScanSort.NameDesc">Nombre (Z-A)</option>
                            <option value="@ScanSort.MostIssues">Más incidencias</option>
                            <option value="@ScanSort.LeastIssues">Menos incidencias</option>
                            <option value="@ScanSort.HighestCompletion">Mayor porcentaje completado</option>
                            <option value="@ScanSort.LowestCompletion">Menor porcentaje completado</option>
                            <option value="@ScanSort.HighestHealth">Mayor salud</option>
                            <option value="@ScanSort.LowestHealth">Menor salud</option>
                            <option value="@ScanSort.MostEpisodes">Más episodios</option>
                            <option value="@ScanSort.LeastEpisodes">Menos episodios</option>
                        </select>
                    </div>

                </MudItem>

                <MudItem xs="12" sm="6" md="3">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="1"
                              Class="h-100">

                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Primary"
                                 Variant="Variant.Outlined">

                            @FilteredRows.Count() series

                        </MudChip>

                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Error"
                                 Variant="Variant.Outlined">

                            @FilteredRows.Count(
                                row => GetVisibleIssues(row).Count > 0)
                            con incidencias

                        </MudChip>

                    </MudStack>

                </MudItem>

                <MudItem xs="12">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween"
                              Spacing="2">

                        <MudSwitch T="bool"
                                   @bind-Value="_showSpecials"
                                   Color="Color.Primary"
                                   Label="Mostrar especiales (temporada 0)" />

                        <MudButtonGroup Variant="Variant.Outlined"
                                        Color="Color.Primary"
                                        Size="Size.Small">

                            <MudButton StartIcon="@Icons.Material.Filled.GridView"
                                       Variant="@(_cardView ? Variant.Filled : Variant.Outlined)"
                                       OnClick="@(() => _cardView = true)">
                                Tarjetas
                            </MudButton>

                            <MudButton StartIcon="@Icons.Material.Filled.ViewList"
                                       Variant="@(!_cardView ? Variant.Filled : Variant.Outlined)"
                                       OnClick="@(() => _cardView = false)">
                                Tabla
                            </MudButton>

                        </MudButtonGroup>

                    </MudStack>

                </MudItem>

            </MudGrid>

            <MudDivider Class="my-3" />

            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween"
                      Spacing="2">

                <MudText Typo="Typo.caption"
                         Color="Color.Secondary">
                    La exportación respeta la búsqueda, el filtro y la ordenación actuales.
                </MudText>

                <MudStack Row="true"
                          Spacing="1">

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Description"
                               Disabled="@(!FilteredRows.Any())"
                               OnClick="ExportCsvAsync">
                        Exportar CSV
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.TableView"
                               Disabled="@(!FilteredRows.Any())"
                               OnClick="ExportExcelAsync">
                        Exportar Excel
                    </MudButton>

                </MudStack>

            </MudStack>

        </MudPaper>

        @if (_cardView)
        {
            <MudGrid Spacing="3">

                @foreach (var row in FilteredRows)
                {
                    <MudItem xs="12" md="6" xl="4">

                        <MudCard Class="@($"scan-series-card {GetCompletionBorderClass(row)}")" Elevation="2">

                            <MudCardContent>

                                <MudStack Row="true"
                                          AlignItems="AlignItems.Start"
                                          Spacing="3">

                                    @if (row.Series is not null &&
                                         !string.IsNullOrWhiteSpace(row.Series.PosterTag))
                                    {
                                        <MudImage Src="@GetPosterUrl(row.Series)"
                                                  Alt="@row.Name"
                                                  Width="112"
                                                  Height="166"
                                                  ObjectFit="ObjectFit.Cover"
                                                  Class="scan-card-poster" />
                                    }
                                    else
                                    {
                                        <MudPaper Width="112px"
                                                  Height="166px"
                                                  Class="d-flex align-center justify-center scan-card-poster">
                                            <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported"
                                                     Size="Size.Large" />
                                        </MudPaper>
                                    }

                                    <MudStack Spacing="2" Class="flex-grow-1 scan-card-main">

                                        <MudStack Row="true"
                                                  AlignItems="AlignItems.Start"
                                                  Justify="Justify.SpaceBetween"
                                                  Spacing="2">

                                            <div>
                                                <MudText Typo="Typo.h6"
                                                         Class="scan-series-title"
                                                         @onclick="@(() => OpenSeries(row.JellyfinId))">
                                                    @row.Name
                                                </MudText>

                                                <MudText Typo="Typo.caption"
                                                         Color="Color.Secondary">
                                                    @(row.Series?.ProductionYear > 0
                                                        ? row.Series.ProductionYear.ToString()
                                                        : "Año desconocido")
                                                    · @(row.Series?.SeasonCount ?? 0) temporada(s)
                                                    · @(row.Series?.EpisodeCount ?? 0) episodio(s)
                                                </MudText>

                                                @if ((row.Series?.TmdbVoteAverage ?? 0) > 0)
                                                {
                                                    <div class="scan-series-rating">
                                                        <div class="scan-series-rating-stars"
                                                             title="@($"TMDb {row.Series!.TmdbVoteAverage:0.0}/10")">
                                                            @for (var star = 1; star <= 5; star++)
                                                            {
                                                                <MudIcon Icon="@(row.Series.TmdbVoteAverage / 2d >= star
                                                                    ? Icons.Material.Filled.Star
                                                                    : row.Series.TmdbVoteAverage / 2d >= star - 0.5
                                                                        ? Icons.Material.Filled.StarHalf
                                                                        : Icons.Material.Filled.StarBorder)"
                                                                         Size="Size.Small"
                                                                         Color="Color.Warning" />
                                                            }
                                                        </div>

                                                        <MudText Typo="Typo.body2"
                                                                 Class="scan-rating-value">
                                                            @row.Series.TmdbVoteAverage.ToString("0.0")/10
                                                        </MudText>

                                                        <MudText Typo="Typo.caption"
                                                                 Color="Color.Secondary">
                                                            TMDb · @FormatVotes(row.Series.TmdbVoteCount) votos
                                                        </MudText>
                                                    </div>
                                                }
                                            </div>

                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@GetRowColor(row)"
                                                     Variant="Variant.Filled"
                                                     Icon="@GetRowIcon(row)">
                                                @GetRowStatus(row)
                                            </MudChip>

                                        </MudStack>

                                        <MudStack Spacing="1">
                                            <MudStack Row="true"
                                                      AlignItems="AlignItems.Center"
                                                      Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2">
                                                    Completada: @FormatCompletion(row)
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @GetAvailableEpisodeCount(row) de @GetExpectedEpisodeCount(row) episodios
                                                </MudText>
                                            </MudStack>
                                            <MudProgressLinear Value="@GetCompletionPercentage(row)"
                                                               Color="@GetCompletionColor(row)"
                                                               Rounded="true" />
                                        </MudStack>

                                        <HealthIndicator Score="@GetHealthScore(row)" />

                                    </MudStack>

                                </MudStack>

                                <MudDivider Class="my-3" />

                                <div class="scan-card-issues">

                                @foreach (var statusIssue in GetStatusIssues(row))
                                {
                                    <MudAlert Severity="@GetStatusSeverity(statusIssue.Type)"
                                              Variant="Variant.Outlined"
                                              Dense="true"
                                              Class="mb-2">
                                        <MudText Typo="Typo.body2">
                                            <strong>@GetIssueLabel(statusIssue.Type):</strong>
                                            @statusIssue.Message
                                        </MudText>
                                    </MudAlert>
                                }

                                @if (GetActionableIssues(row).Count == 0 &&
                                     GetStatusIssues(row).Count == 0)
                                {
                                    <MudAlert Severity="Severity.Success"
                                              Variant="Variant.Outlined">
                                        No se han detectado incidencias.
                                    </MudAlert>
                                }
                                else if (GetActionableIssues(row).Count > 0)
                                {
                                    <MissingEpisodesGroup Issues="GetActionableIssues(row)"
                                                          MaxGroups="4" />
                                }
                                </div>

                            </MudCardContent>

                            <MudCardActions Class="px-4 pb-4">

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Visibility"
                                           Disabled="@string.IsNullOrWhiteSpace(row.JellyfinId)"
                                           OnClick="@(() => OpenSeries(row.JellyfinId))">
                                    Ver detalle
                                </MudButton>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                           Disabled="@string.IsNullOrWhiteSpace(row.JellyfinId)"
                                           OnClick="@(() => OpenInJellyfinAsync(row.JellyfinId))">
                                    Jellyfin
                                </MudButton>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.CompareArrows"
                                           Disabled="@(!row.CanCompare)"
                                           OnClick="@(() => OpenComparison(row.JellyfinId))">
                                    Comparar
                                </MudButton>

                            </MudCardActions>

                        </MudCard>

                    </MudItem>
                }

            </MudGrid>
        }
        else
        {
        <MudTable T="ScanSeriesRow"
                  Items="@FilteredRows"
                  Dense="false"
                  Hover="true"
                  Striped="true"
                  Elevation="1">

            <HeaderContent>

                <MudTh Style="width:76px;">
                    Póster
                </MudTh>

                <MudTh Style="min-width:190px;">
                    Serie
                </MudTh>

                <MudTh Style="min-width:460px;">
                    Resultado del escaneo
                </MudTh>

                <MudTh Style="width:80px;">
                    Año
                </MudTh>

                <MudTh Style="width:105px;">
                    Temporadas
                </MudTh>

                <MudTh Style="width:105px;">
                    Episodios
                </MudTh>

                <MudTh Style="width:180px;">
                    Completada
                </MudTh>

                <MudTh Style="width:170px;">
                    Salud
                </MudTh>

                <MudTh Style="width:165px;">
                    Estado
                </MudTh>

                <MudTh Style="width:120px;">
                    Acción
                </MudTh>

            </HeaderContent>

            <RowTemplate>

                <MudTd DataLabel="Póster">

                    @if (context.Series is not null &&
                         !string.IsNullOrWhiteSpace(
                             context.Series.PosterTag))
                    {
                        <MudImage Src="@GetPosterUrl(context.Series)"
                                  Alt="@context.Name"
                                  Width="54"
                                  Height="78"
                                  ObjectFit="ObjectFit.Cover"
                                  Class="scan-poster" />
                    }
                    else
                    {
                        <MudPaper Width="54px"
                                  Height="78px"
                                  Class="d-flex align-center justify-center">

                            <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported"
                                     Size="Size.Small" />

                        </MudPaper>
                    }

                </MudTd>

                <MudTd DataLabel="Serie">

                    <MudText Typo="Typo.subtitle1"
                             Class="scan-series-title"
                             @onclick="@(() =>
                                 OpenSeries(context.JellyfinId))">

                        @context.Name

                    </MudText>

                    @if (GetVisibleIssues(context).Count > 0)
                    {
                        <MudText Typo="Typo.caption"
                                 Color="Color.Error">

                            @GetVisibleIssues(context).Count incidencia(s)

                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption"
                                 Color="Color.Success">

                            Sin incidencias

                        </MudText>
                    }

                </MudTd>

                <MudTd DataLabel="Resultado del escaneo">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Start"
                              Spacing="1">

                        <MudTooltip Text="Ver serie">

                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@string.IsNullOrWhiteSpace(
                                               context.JellyfinId)"
                                           OnClick="@(() =>
                                               OpenSeries(
                                                   context.JellyfinId))" />

                        </MudTooltip>

                        @if (GetVisibleIssues(context).Count == 0)
                        {
                            <MudStack Row="true"
                                      AlignItems="AlignItems.Center"
                                      Spacing="1">

                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                         Color="Color.Success"
                                         Size="Size.Small" />

                                <MudText Typo="Typo.body2"
                                         Color="Color.Success">

                                    No se han detectado incidencias.

                                </MudText>

                            </MudStack>
                        }
                        else
                        {
                            <MissingEpisodesGroup Issues="GetVisibleIssues(context)"
                                                  MaxGroups="5" />
                        }

                    </MudStack>

                </MudTd>

                <MudTd DataLabel="Año">

                    @(context.Series?.ProductionYear > 0
                        ? context.Series.ProductionYear.ToString()
                        : "—")

                </MudTd>

                <MudTd DataLabel="Temporadas">

                    @(context.Series?.SeasonCount.ToString()
                        ?? "—")

                </MudTd>

                <MudTd DataLabel="Episodios">

                    @(context.Series?.EpisodeCount.ToString()
                        ?? "—")

                </MudTd>

                <MudTd DataLabel="Completada">

                    <MudStack Spacing="1">

                        <MudStack Row="true"
                                  AlignItems="AlignItems.Center"
                                  Justify="Justify.SpaceBetween">

                            <MudText Typo="Typo.body2">
                                @FormatCompletion(context)
                            </MudText>

                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">
                                @GetAvailableEpisodeCount(context) de
                                @GetExpectedEpisodeCount(context) episodios
                            </MudText>

                        </MudStack>

                        <MudProgressLinear Value="@GetCompletionPercentage(context)"
                                           Color="@GetCompletionColor(context)"
                                           Rounded="true" />

                    </MudStack>

                </MudTd>

                <MudTd DataLabel="Salud">

                    <HealthIndicator Score="@GetHealthScore(context)" />

                </MudTd>

                <MudTd DataLabel="Estado">

                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@GetRowColor(context)"
                             Variant="Variant.Filled"
                             Icon="@GetRowIcon(context)">

                        @GetRowStatus(context)

                    </MudChip>

                </MudTd>

                <MudTd DataLabel="Acción">

                    <MudStack Row="true"
                              Spacing="1">

                        <MudTooltip Text="Abrir en Jellyfin">

                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@string.IsNullOrWhiteSpace(
                                               context.JellyfinId)"
                                           OnClick="@(() =>
                                               OpenInJellyfinAsync(
                                                   context.JellyfinId))" />

                        </MudTooltip>

                        <MudTooltip Text="Comparar con TMDb">

                            <MudIconButton Icon="@Icons.Material.Filled.CompareArrows"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           Disabled="@(!context.CanCompare)"
                                           OnClick="@(() =>
                                               OpenComparison(
                                                   context.JellyfinId))" />

                        </MudTooltip>

                    </MudStack>

                </MudTd>

            </RowTemplate>

            <PagerContent>

                <MudTablePager PageSizeOptions="
                    new int[] { 10, 25, 50, 100 }" />

            </PagerContent>

        </MudTable>
        }
    }
    else
    {
        <MudAlert Severity="Severity.Warning"
                  Variant="Variant.Outlined">

            El escaneo no ha devuelto ninguna serie.

        </MudAlert>
    }
}

