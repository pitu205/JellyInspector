    private static string FormatDuration(
        TimeSpan duration)
    {
        return duration.TotalMinutes >= 1
            ? $"{(int)duration.TotalMinutes} min " +
              $"{duration.Seconds} s"
            : $"{duration.TotalSeconds:0.0} s";
    }


    private static int GetAvailableEpisodeCount(
        ScanSeriesRow row)
    {
        return row.Series?.EpisodeCount ?? 0;
    }

    private int GetMissingEpisodeCount(
        ScanSeriesRow row)
    {
        return GetVisibleIssues(row).Count(issue =>
            issue.Type == ScanIssueType.MissingEpisode);
    }

    private int GetExpectedEpisodeCount(
        ScanSeriesRow row)
    {
        return GetAvailableEpisodeCount(row) +
               GetMissingEpisodeCount(row);
    }

    private double GetCompletionPercentage(
        ScanSeriesRow row)
    {
        var expected = GetExpectedEpisodeCount(row);

        if (expected <= 0)
        {
            return GetActionableIssues(row).Count == 0 ? 100d : 0d;
        }

        return Math.Clamp(
            GetAvailableEpisodeCount(row) * 100d / expected,
            0d,
            100d);
    }

    private string FormatCompletion(
        ScanSeriesRow row)
    {
        return $"{GetCompletionPercentage(row):0.#} %";
    }

    private int GetHealthScore(
        ScanSeriesRow row)
    {
        var penalty = 0;

        foreach (var issue in GetActionableIssues(row))
        {
            penalty += issue.Type switch
            {
                ScanIssueType.MissingEpisode => 1,
                ScanIssueType.MissingSeason => 15,
                ScanIssueType.DuplicateEpisode => 2,
                ScanIssueType.MissingPoster => 5,
                ScanIssueType.MissingOverview => 5,
                ScanIssueType.MissingTmdb => 10,
                ScanIssueType.MetadataMismatch => 5,
                _ => 0
            };
        }

        return Math.Clamp(100 - penalty, 0, 100);
    }

    private string GetCompletionBorderClass(
        ScanSeriesRow row)
    {
        var percentage = GetCompletionPercentage(row);

        if (percentage >= 100d)
        {
            return "scan-series-card-complete";
        }

        if (percentage >= 80d)
        {
            return "scan-series-card-warning";
        }

        return "scan-series-card-critical";
    }

    private Color GetCompletionColor(
        ScanSeriesRow row)
    {
        var percentage = GetCompletionPercentage(row);

        if (percentage >= 100d)
        {
            return Color.Success;
        }

        if (percentage >= 90d)
        {
            return Color.Warning;
        }

        return Color.Error;
    }

