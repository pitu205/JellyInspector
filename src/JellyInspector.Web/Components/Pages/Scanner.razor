    private string GetLibrarySummary()
    {
        if (_scanRows.Count == 0)
        {
            return "No hay series disponibles para calcular el estado de la biblioteca.";
        }

        if (AffectedSeriesCount == 0)
        {
            return $"Las {_scanRows.Count} series analizadas están al día. " +
                   $"{AiringSeriesCount} en emisión y " +
                   $"{UpcomingSeriesCount} con próximos estrenos.";
        }

        return $"{CompleteSeriesCount} de {_scanRows.Count} series están al día. " +
               $"{AiringSeriesCount} en emisión, " +
               $"{UpcomingSeriesCount} próximamente, " +
               $"{AffectedSeriesCount} con incidencias, " +
               $"{MissingEpisodeIssueCount} episodio(s) faltante(s) y " +
               $"{MissingSeasonIssueCount} temporada(s) faltante(s).";
    }

    private Color GetRowColor(
        ScanSeriesRow row)
    {
        var actionableIssues = GetActionableIssues(row);
        var statusIssues = GetStatusIssues(row);

        if (actionableIssues.Any(issue =>
            issue.Type is
                ScanIssueType.MissingEpisode or
                ScanIssueType.MissingSeason or
                ScanIssueType.DuplicateEpisode))
        {
            return Color.Error;
        }

        if (actionableIssues.Count > 0)
        {
            return Color.Warning;
        }

        if (statusIssues.Any(issue =>
            issue.Type == ScanIssueType.Airing))
        {
            return Color.Info;
        }

        if (statusIssues.Any(issue =>
            issue.Type == ScanIssueType.Upcoming))
        {
            return Color.Secondary;
        }

        return Color.Success;
    }

    private string GetRowIcon(
        ScanSeriesRow row)
    {
        var actionableIssues = GetActionableIssues(row);
        var statusIssues = GetStatusIssues(row);

        if (actionableIssues.Any(issue =>
            issue.Type is
                ScanIssueType.MissingEpisode or
                ScanIssueType.MissingSeason or
                ScanIssueType.DuplicateEpisode))
        {
            return Icons.Material.Filled.Error;
        }

        if (actionableIssues.Count > 0)
        {
            return Icons.Material.Filled.Warning;
        }

        if (statusIssues.Any(issue =>
            issue.Type == ScanIssueType.Airing))
        {
            return Icons.Material.Filled.LiveTv;
        }

        if (statusIssues.Any(issue =>
            issue.Type == ScanIssueType.Upcoming))
        {
            return Icons.Material.Filled.Schedule;
        }

        return Icons.Material.Filled.CheckCircle;
    }

    private string GetRowStatus(
        ScanSeriesRow row)
    {
        var actionableIssues = GetActionableIssues(row);
        var statusIssues = GetStatusIssues(row);

        var missingEpisodes =
            actionableIssues.Count(issue =>
                issue.Type ==
                ScanIssueType.MissingEpisode);

        var missingSeasons =
            actionableIssues.Count(issue =>
                issue.Type ==
                ScanIssueType.MissingSeason);

        if (missingEpisodes > 0 &&
            missingSeasons > 0)
        {
            return
                $"{missingEpisodes} episodio(s) y " +
                $"{missingSeasons} temporada(s)";
        }

        if (missingEpisodes > 0)
        {
            return
                $"{missingEpisodes} episodio(s) faltante(s)";
        }

        if (missingSeasons > 0)
        {
            return
                $"{missingSeasons} temporada(s) faltante(s)";
        }

        if (actionableIssues.Count > 0)
        {
            return
                $"{actionableIssues.Count} incidencia(s)";
        }

        if (statusIssues.Any(issue =>
            issue.Type == ScanIssueType.Airing))
        {
            return "En emisión";
        }

        if (statusIssues.Any(issue =>
            issue.Type == ScanIssueType.Upcoming))
        {
            return "Próximamente";
        }

        return "Completa";
    }

