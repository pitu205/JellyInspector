@code
{
    private static string FormatVotes(int votes)
    {
        return votes.ToString("N0");
    }


    private bool IsScanRunning =>
        ScannerService.IsRunning;

    private bool _monitoringScan;

    private bool _cancellingScan;

    private bool _loadingLastScan = true;

    private ScanResult? _result;

    private string? _errorMessage;

    private string _search = string.Empty;

    private ScanFilter _filter = ScanFilter.WithIssues;

    private ScanSort _sort = ScanSort.NameAsc;

    private bool _showSpecials = true;

    private bool _cardView = true;

    private List<ScanSeriesRow> _scanRows = [];

    private int AffectedSeriesCount =>
        _scanRows.Count(row => GetActionableIssues(row).Count > 0);

    private int CompleteSeriesCount =>
        _scanRows.Count(row => GetActionableIssues(row).Count == 0);

    private int PerfectSeriesCount =>
        _scanRows.Count(row =>
            GetActionableIssues(row).Count == 0 &&
            GetStatusIssues(row).Count == 0);

    private int AiringSeriesCount =>
        _scanRows.Count(row => GetStatusIssues(row).Any(issue =>
            issue.Type == ScanIssueType.Airing));

    private int UpcomingSeriesCount =>
        _scanRows.Count(row => GetStatusIssues(row).Any(issue =>
            issue.Type == ScanIssueType.Upcoming));

    private int WarningSeriesCount =>
        _scanRows.Count(row =>
            GetActionableIssues(row).Count > 0 &&
            GetHealthScore(row) >= 75 &&
            GetHealthScore(row) < 100);

    private int CriticalSeriesCount =>
        _scanRows.Count(row =>
            GetActionableIssues(row).Count > 0 &&
            GetHealthScore(row) < 75);

    private int MissingEpisodeIssueCount =>
        _scanRows.Sum(row => GetVisibleIssues(row).Count(issue =>
            issue.Type == ScanIssueType.MissingEpisode));

    private int MissingSeasonIssueCount =>
        _scanRows.Sum(row => GetVisibleIssues(row).Count(issue =>
            issue.Type == ScanIssueType.MissingSeason));

    private double LibraryHealthPercentage =>
        _scanRows.Count == 0
            ? 100d
            : _scanRows.Average(row => GetHealthScore(row));

    private IEnumerable<ScanSeriesRow> FilteredRows =>
        ApplySorting(
            _scanRows
                .Where(MatchesSearch)
                .Where(MatchesFilter));

    protected override async Task OnInitializedAsync()
    {
        await LoadLastScanAsync();

        var activeScan = ScannerService.ActiveScanTask;

        if (activeScan is { IsCompleted: false })
        {
            _ = MonitorScanAsync(activeScan);
        }
    }

    private async Task LoadLastScanAsync()
    {
        _loadingLastScan = true;
        _errorMessage = null;

        try
        {
            _result =
                await LastScanService.GetLastAsync();

            if (_result is not null)
            {
                await BuildScanRowsAsync();

                _filter =
                    ScanFilter.WithIssues;
            }
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"No se pudo cargar el último escaneo: {ex.Message}";
        }
        finally
        {
            _loadingLastScan = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopScanAsync()
    {
        if (!ScannerService.IsRunning || _cancellingScan)
        {
            return;
        }

        _cancellingScan = true;

        try
        {
            await ScannerService.CancelScanAsync();
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _cancellingScan = false;
        }
    }

    private async Task StartScan()
    {
        _result = null;
        _scanRows.Clear();
        _errorMessage = null;
        _search = string.Empty;
        _filter = ScanFilter.WithIssues;

        await InvokeAsync(StateHasChanged);

        var scanTask =
            ScannerService.ScanAsync(string.Empty);

        await MonitorScanAsync(scanTask);
    }

    private async Task MonitorScanAsync(
        Task<ScanResult> scanTask)
    {
        if (_monitoringScan)
        {
            return;
        }

        _monitoringScan = true;

        try
        {
            while (!scanTask.IsCompleted)
            {
                await Task.Delay(100);
                await InvokeAsync(StateHasChanged);
            }

            _result = await scanTask;

            await BuildScanRowsAsync();

            _filter = ScanFilter.WithIssues;
        }
        catch (OperationCanceledException)
        {
            _errorMessage = null;
            await LoadLastScanAsync();
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"El escaneo ha fallado: {ex.Message}";

            await LoadLastScanAsync();
        }
        finally
        {
            _monitoringScan = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task BuildScanRowsAsync()
    {
        if (_result is null)
        {
            _scanRows.Clear();
            return;
        }

        var library =
            await LibraryService.GetSeriesAsync();

        var issuesBySeries =
            _result.Issues
                .GroupBy(
                    issue => issue.SeriesName,
                    StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    group => group.Key,
                    group => group
                        .OrderBy(issue => issue.SeasonNumber)
                        .ThenBy(issue => issue.EpisodeNumber)
                        .ToList(),
                    StringComparer.OrdinalIgnoreCase);

        _scanRows = library
            .Select(series =>
            {
                issuesBySeries.TryGetValue(
                    series.Name,
                    out var seriesIssues);

                return new ScanSeriesRow
                {
                    Name =
                        series.Name,

                    JellyfinId =
                        series.JellyfinId,

                    Series =
                        series,

                    Issues =
                        seriesIssues ?? []
                };
            })
            .OrderBy(row => row.Name)
            .ToList();
    }


    private IEnumerable<ScanSeriesRow> ApplySorting(IEnumerable<ScanSeriesRow> rows)
    {
        return _sort switch
        {
            ScanSort.NameDesc => rows.OrderByDescending(r => r.Name),
            ScanSort.MostIssues => rows.OrderByDescending(r => GetActionableIssues(r).Count).ThenBy(r => r.Name),
            ScanSort.LeastIssues => rows.OrderBy(r => GetActionableIssues(r).Count).ThenBy(r => r.Name),
            ScanSort.HighestCompletion => rows.OrderByDescending(GetCompletionPercentage).ThenBy(r=>r.Name),
            ScanSort.LowestCompletion => rows.OrderBy(GetCompletionPercentage).ThenBy(r=>r.Name),
            ScanSort.HighestHealth => rows.OrderByDescending(GetHealthScore).ThenBy(r => r.Name),
            ScanSort.LowestHealth => rows.OrderBy(GetHealthScore).ThenBy(r => r.Name),
            ScanSort.MostEpisodes => rows.OrderByDescending(GetAvailableEpisodeCount).ThenBy(r=>r.Name),
            ScanSort.LeastEpisodes => rows.OrderBy(GetAvailableEpisodeCount).ThenBy(r=>r.Name),
            _ => rows.OrderBy(r => r.Name)
        };
    }

    private void ApplyHealthFilter(
        ScanFilter filter)
    {
        _filter = _filter == filter
            ? ScanFilter.All
            : filter;
    }

    private string GetHealthFilterClass(
        ScanFilter filter,
        string statusClass)
    {
        var activeClass = _filter == filter
            ? " scan-health-status-active"
            : string.Empty;

        return $"scan-health-status {statusClass}{activeClass}";
    }

    private string GetStatFilterClass(
        ScanFilter filter)
    {
        var active = _filter == filter
            ? " scan-stat-button-active"
            : string.Empty;

        return $"scan-stat-button{active}";
    }

    private bool MatchesSearch(
        ScanSeriesRow row)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        return row.Name.Contains(
                   _search,
                   StringComparison.OrdinalIgnoreCase)
               ||
               GetVisibleIssues(row).Any(issue =>
                   issue.Message.Contains(
                       _search,
                       StringComparison.OrdinalIgnoreCase)
                   ||
                   GetIssueDescription(issue).Contains(
                       _search,
                       StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesFilter(
        ScanSeriesRow row)
    {
        return _filter switch
        {
            ScanFilter.All =>
                true,

            ScanFilter.WithIssues =>
                GetActionableIssues(row).Count > 0,

            ScanFilter.Complete =>
                GetActionableIssues(row).Count == 0,

            ScanFilter.MissingEpisodes =>
                GetVisibleIssues(row).Any(issue =>
                    issue.Type ==
                    ScanIssueType.MissingEpisode),

            ScanFilter.MissingSeasons =>
                GetActionableIssues(row).Any(issue =>
                    issue.Type ==
                    ScanIssueType.MissingSeason),

            ScanFilter.Airing =>
                GetStatusIssues(row).Any(issue =>
                    issue.Type == ScanIssueType.Airing),

            ScanFilter.Upcoming =>
                GetStatusIssues(row).Any(issue =>
                    issue.Type == ScanIssueType.Upcoming),

            ScanFilter.Perfect =>
                GetActionableIssues(row).Count == 0 &&
                GetStatusIssues(row).Count == 0,

            ScanFilter.HealthWarnings =>
                GetActionableIssues(row).Count > 0 &&
                GetHealthScore(row) >= 75 &&
                GetHealthScore(row) < 100,

            ScanFilter.Critical =>
                GetActionableIssues(row).Count > 0 &&
                GetHealthScore(row) < 75,

            ScanFilter.Metadata =>
                GetVisibleIssues(row).Any(issue =>
                    issue.Type is
                        ScanIssueType.MissingPoster or
                        ScanIssueType.MissingOverview or
                        ScanIssueType.MissingTmdb or
                        ScanIssueType.MetadataMismatch),

            ScanFilter.Duplicates =>
                GetVisibleIssues(row).Any(issue =>
                    issue.Type ==
                    ScanIssueType.DuplicateEpisode),

            _ =>
                true
        };
    }

    private List<ScanIssue> GetVisibleIssues(
        ScanSeriesRow row)
    {
        return _showSpecials
            ? row.Issues
            : row.Issues
                .Where(issue => !IsSpecialIssue(issue))
                .ToList();
    }

    private List<ScanIssue> GetActionableIssues(
        ScanSeriesRow row)
    {
        return GetVisibleIssues(row)
            .Where(issue => !IsStatusIssue(issue))
            .ToList();
    }

    private List<ScanIssue> GetStatusIssues(
        ScanSeriesRow row)
    {
        return GetVisibleIssues(row)
            .Where(IsStatusIssue)
            .ToList();
    }

    private static bool IsStatusIssue(
        ScanIssue issue)
    {
        return issue.Type is
            ScanIssueType.Airing or
            ScanIssueType.Upcoming;
    }

    private static bool IsSpecialIssue(
        ScanIssue issue)
    {
        return issue.SeasonNumber == 0;
    }

    private static string GetIssueDescription(
        ScanIssue issue)
    {
        if (issue.Type == ScanIssueType.MissingEpisode &&
            issue.SeasonNumber.HasValue &&
            issue.EpisodeNumber.HasValue)
        {
            return
                $"Falta T{issue.SeasonNumber.Value:00}" +
                $"E{issue.EpisodeNumber.Value:00}.";
        }

        if (issue.Type == ScanIssueType.MissingSeason &&
            issue.SeasonNumber.HasValue)
        {
            return
                $"Falta la temporada " +
                $"{issue.SeasonNumber.Value}.";
        }

        return issue.Message;
    }

    private static string GetPosterUrl(
